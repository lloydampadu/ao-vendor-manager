{
  "expo": {
    "name": "AO Vendor Manager",
    "slug": "ao-vendor-manager",
    "version": "1.0.0",
    "scheme": "aovendor",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.abosseyokaidirect.vendormanager",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0060C0"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "versionCode": 2
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.abosseyokaidirect.vendormanager",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Take photos of the parts you are quoting or listing so customers can see exactly what they will get.",
        "NSLocationWhenInUseUsageDescription": "Attach your shop location to a quote so AbosseyOkai can arrange pickup.",
        "NSPhotoLibraryUsageDescription": "Choose a profile photo for your vendor account."
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0060C0",
          "sounds": [
            "./assets/notification_request.wav"
          ]
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0060C0"
        }
      ],
      "@sentry/react-native",
      [
        "@sentry/react-native/expo",
        {
          "organization": "abossey-okai-direct",
          "project": "ao-vendor-manager",
          "url": "https://sentry.io/"
        }
      ],
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "64fab91e-1093-4f3d-a321-da6c44de5d0d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/64fab91e-1093-4f3d-a321-da6c44de5d0d",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
