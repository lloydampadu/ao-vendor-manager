{
  "expo": {
    "name": "AO Vendor Manager",
    "slug": "ao-vendor-manager",
    "version": "1.0.0",
    "scheme": "aovendor",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.abosseyokaidirect.vendormanager",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0060C0"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.abosseyokaidirect.vendormanager",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0060C0",
          "sounds": [
            "./assets/notification_request.wav"
          ]
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0060C0"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "64fab91e-1093-4f3d-a321-da6c44de5d0d"
      }
    }
  }
}
